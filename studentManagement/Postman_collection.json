                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n\"name\":\"John Doe\",\n\"studentCode\":\"ST001\",\n\"dateOfBirth\":\"2000-05-15\",\n\"gender\":\"Male\",\n\"email\":\"john@example.com\",\n\"mobileNumber\":\"9876543210\",\n\"fatherName\":\"Robert Doe\",\n\"motherName\":\"Jane Doe\"\n}"
